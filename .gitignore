# Local runtime data: the real games, avatars, personal photos and voice cache (mounted as /data)
/data/

# Safety net: never commit a database or a voice model created outside /data by mistake
*.db
*.db-*
*.sqlite3
*.onnx
*.onnx.json

# Secrets (keep a template under the name .env.example)
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
*.egg-info/
build/
dist/

# Editor and OS
.vscode/
.idea/
*.swp
*~
.DS_Store
Thumbs.db
desktop.ini

# Claude Code's local settings
.claude/settings.local.json

# Design originals and drafts the game does not use (it uses board.webp and what game.yaml names)
content/games/*/board.png
content/games/*/lights/rocketship.png
content/games/space-race-expanded/lights/moon.png

# Instructions for Claude Code: local only, never in the repo
CLAUDE.md
CLAUDE.local.md
.claude/
